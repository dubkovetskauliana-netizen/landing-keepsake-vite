include ../data/data
include ../includes/_mixins

doctype html
html(lang='uk')
  head
    block meta
      meta(charset='UTF-8')
      meta(name='viewport', content='width=device-width, initial-scale=1.0')
    block title
      title Keepsake — Дизайн-агенція
    block styles
      link(rel='preconnect', href='https://googleapis.com')
      link(rel='preconnect', href='https://gstatic.com', crossorigin)
      link(
        href='https://googleapis.com/css2?family=Dancing+Script:wght@700&family=Open+Sans:wght@300;400;700&family=Oswald:wght@300;400;700&display=swap',
        rel='stylesheet'
      )
      link(rel='stylesheet', href='/src/styles/main.scss')
  body
    include ../includes/svg-sprite
    include ../components/header
    main.main
      block content
    include ../components/footer
    a.scroll-top(href='#hero', aria-label='Повернутися на початок сторінки')
      +icon('arrow-up', 20)
    block scripts
