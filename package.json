{
  "name": "landing-keepsake-vite",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.js",
    "format": "prettier --write .",
    "lint": "npm run lint:styles && npm run lint:format",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "lint:format": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@prettier/plugin-pug": "^3.6.0",
    "@vituum/vite-plugin-pug": "^1.1.0",
    "autoprefixer": "^10.6.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "sass": "^1",
    "sharp": "^0.35.5",
    "stylelint": "^18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "vite": "8.3.3",
    "vituum": "^1.2.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Edge versions",
    "last 2 Safari versions",
    "last 2 iOS versions"
  ],
  "lint-staged": {
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{pug,js,json,md}": [
      "prettier --write"
    ]
  }
}
